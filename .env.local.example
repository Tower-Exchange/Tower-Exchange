# Tower Finance - Environment Variables Template

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional server-only aliases for background jobs.
# The cron route can invoke Supabase Edge Functions with the anon key; the
# Edge Function itself uses Supabase's own SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# CRON_SECRET=your-vercel-cron-secret

# HMAC secret for wallet session cookies (nonce + signed-in session).
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset — set a dedicated secret in production.
# WALLET_SESSION_SECRET=generate-a-long-random-string

# ============================================================================
# LEGION PARTNER VERIFICATION INTEGRATION
# ============================================================================
# Partner token registered with Republic via PUT /api/partner/connection
# (24-2048 printable ASCII chars, no spaces). REQUIRED: /api/legion/verify
# returns 503 if unset and 401 if the Bearer token doesn't match.
LEGION_WEBHOOK_SECRET=your-legion-webhook-secret
# Only during token rotation: the old token, still accepted until removed.
# LEGION_WEBHOOK_SECRET_PREVIOUS=
# Contracts a verified SWAP must be sent to (comma-separated, lowercase or
# checksummed): the TowerSwapExecutor(s) and Tower DEX router. Strongly
# recommended in production: it stops a user from labelling an unrelated
# transaction as a "swap" to farm quest volume. Empty = not enforced.
# LEGION_TRUSTED_CONTRACTS=0xeB8940752Fa12944d3b2D736d51fA36E4dA32BC8,0xDf115b4f2F22B9255B2E63348423B6C5B379Bce2
# ============================================================================
# RAINBOWKIT & WALLET CONNECTION
# ============================================================================
# Required for RainbowKit custom wallet lists and mobile wallet selection
# Get one from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Optional alias if you prefer Reown naming instead
# NEXT_PUBLIC_REOWN_PROJECT_ID=your-walletconnect-project-id

# ============================================================================
# BLOCKCHAIN CONFIGURATION
# ============================================================================
# Bridge switches. Both bridge types are off by default; set the matching
# variable to true to enable that route type in the UI and API.
NEXT_PUBLIC_EVM_BRIDGE_ENABLED=false
NEXT_PUBLIC_SOLANA_BRIDGE_ENABLED=false

# Arc Testnet RPC (optional, has default fallback)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Arc mainnet RPC used by /api/rpc/5042 and Hardhat --network arc-mainnet.
# Official public endpoint: https://rpc.mainnet.arc.io
# Fallbacks: rpc.blockdaemon.mainnet.arc.io, rpc.drpc.mainnet.arc.io,
# rpc.quicknode.mainnet.arc.io. Prefer a keyed Alchemy URL for deploys.
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# ARC_MAINNET_ALCHEMY_RPC_URL=https://arc-mainnet.g.alchemy.com/v2/YOUR_KEY

# Solana mainnet RPC used by /api/rpc/solana-mainnet for CCTP bridges.
# SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Server-only sponsor keypairs used to create a bridge wallet's USDC ATA when
# it does not exist (including the source ATA for Solana-to-EVM bridges).
# Keep devnet and mainnet sponsors separate; each must hold SOL on its cluster.
# SOLANA_DEVNET_ATA_SPONSOR_SECRET_KEY=
# SOLANA_MAINNET_ATA_SPONSOR_SECRET_KEY=

# ============================================================================
# CIRCLE STABLEFX (server-only; permissioned institutional FX on Arc)
# ============================================================================
# Do not use NEXT_PUBLIC_ for any StableFX setting. StableFX supports only
# currencies and corridors your Circle institution is approved to trade.
# CIRCLE_STABLEFX_ENABLED=false
# CIRCLE_STABLEFX_API_KEY=
# Mainnet default: https://api.circle.com
# Sandbox: https://api-sandbox.circle.com
# CIRCLE_STABLEFX_API_BASE_URL=https://api.circle.com
# The one Tower-controlled Arc EOA approved by Circle to sign the executable
# quote and Permit2 funding payload. It receives customer deposits and StableFX
# proceeds; it is NOT a generic treasury, bridge recipient, or user wallet.
# CIRCLE_STABLEFX_TAKER_ADDRESS=0xYourApprovedArcTakerWallet
# Inject this only through your production secret manager / HSM boundary. Never
# commit it or expose it to the browser. It must derive the address above.
# CIRCLE_STABLEFX_TAKER_PRIVATE_KEY=
# Optional compatibility allowlist of Tower's approved takers. When set, it
# must include CIRCLE_STABLEFX_TAKER_ADDRESS.
# CIRCLE_STABLEFX_TAKER_WALLETS=0xYourApprovedArcTakerWallet
# Tower's source-token StableFX fee in basis points. The customer enters a
# gross amount; Tower retains this fee and sends the net amount to Circle.
# Example: 30 = 0.30%. Defaults to 0. Set this as a Railway server variable.
# TOWER_STABLEFX_FEE_BPS=30
# StableFX uses the existing ARC_MAINNET_RPC_URL / ARC_MAINNET_ALCHEMY_RPC_URL
# configuration and the app's Arc mainnet fallbacks. No separate RPC is needed.
# Circle signs webhook deliveries with ECDSA. The receiver uses this server-only
# key to obtain Circle's public signing key; it falls back to CIRCLE_STABLEFX_API_KEY.
# Set a dedicated key only if Circle issued one for the Webhooks product.
# CIRCLE_STABLEFX_WEBHOOK_API_KEY=
# Optional production-only guard: copy the subscription ID after creating the
# StableFX webhook in Circle Hub. Leave unset only until that subscription exists.
# CIRCLE_STABLEFX_WEBHOOK_SUBSCRIPTION_ID=
# Normally https://api.circle.com. Set only if Circle provides a different
# notification API base URL for your StableFX environment.
# CIRCLE_STABLEFX_WEBHOOK_API_BASE_URL=https://api.circle.com
# The code fixes Circle's official Arc mainnet StableFX contracts at USDC
# 0x3600000000000000000000000000000000000000, EURC
# 0xbEf5f6d51CB62b58e6A8f77868681825C6fe21c1, GBPA
# 0xbBe6aAB0Ed76e90AeA0d1cd978EC231c8AdCDF8b, MXNB
# 0xF197FFC28c23E0309B5559e7a166f2c6164C80aA, and AUDF
# 0xd2a530170D71a9Cfe1651Fb468E2B98F7Ed7456b (all 6 decimals).

# Public and in-app swap quote lifetime in seconds (used by /api/swap/quote and
# /api/public/swap/quote, enforced by both build-tx routes). Default 120, clamp 5-600.
# SWAP_QUOTE_TTL_SECONDS=120

# Tower Router Address on Arc Testnet
TOWER_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TOWER_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000

# Tower AMM V2-style pool router used by Tower pool pages and Tower DEX quotes
TOWER_DEX_ROUTER_ADDRESS=0xDf115b4f2F22B9255B2E63348423B6C5B379Bce2
NEXT_PUBLIC_TOWER_DEX_ROUTER_ADDRESS=0xDf115b4f2F22B9255B2E63348423B6C5B379Bce2

# Optional Tower bridge fee collected through Arc AppKit.
# This is an absolute USDC amount added on top of the bridge amount on the source chain.
# Use an EVM recipient for EVM source bridges and a Solana recipient for Solana source bridges.
NEXT_PUBLIC_BRIDGE_CUSTOM_FEE_USDC=0.10
NEXT_PUBLIC_BRIDGE_FEE_RECIPIENT=0xYourEvmTreasuryWallet
# Optional explicit aliases:
# NEXT_PUBLIC_BRIDGE_FEE_RECIPIENT_EVM=0xYourEvmTreasuryWallet
# NEXT_PUBLIC_BRIDGE_FEE_RECIPIENT_SOLANA=YourSolanaWalletAddress

# TowerSwapExecutor on Arc Testnet
# This is the new stateless fee router. Keep swaps paused until the app and
# Tower-Backend build transactions through this executor instead of FeeCollector.
TOWER_SWAP_EXECUTOR_ADDRESS=0x2De8906a641d65d490bC60A4179d961d59742bCb
NEXT_PUBLIC_TOWER_SWAP_EXECUTOR_ADDRESS=0x2De8906a641d65d490bC60A4179d961d59742bCb
# Arc mainnet Aero Slipstream adapter (allowlisted in TowerSwapExecutor)
# NEXT_PUBLIC_AERO_ADAPTER_MAINNET_ADDRESS=0x8Cef6E2465fb09D2b512B1CaC94F74734741B30a
# NEXT_PUBLIC_TOWER_SWAP_EXECUTOR_MAINNET_ADDRESS=0xeB8940752Fa12944d3b2D736d51fA36E4dA32BC8

# UnitFlow is only enabled through the dedicated UnitFlowAdapter. Leave empty
# until the adapter is deployed and allowlisted in TowerSwapExecutor.
UNITFLOW_ADAPTER_ADDRESS=0xYourUnitFlowAdapter
# NEXT_PUBLIC_UNITFLOW_ADAPTER_ADDRESS=0xYourUnitFlowAdapter

# Recurring order executor automation
NEXT_PUBLIC_RECURRING_ORDER_EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_RECURRING_ORDER_DEX_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
# Server-only Supabase Edge Function secrets:
# RECURRING_ORDER_EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000
# RECURRING_ORDER_RELAYER_PRIVATE_KEY=your-relayer-private-key
# RECURRING_ORDERS_DISABLED=true
# RECURRING_ORDER_ROUTE_TARGETS=0xYourXyloNetRouterOrAdapter
# RECURRING_ORDER_APPROVAL_SPENDERS=0xYourXyloNetTokenSpender
# RECURRING_ORDER_MIN_OUTPUT_BPS=9900
# RECURRING_ORDER_MAX_ORDERS_PER_RUN=25
# RECURRING_ORDER_DELAY_MS=1000

# ============================================================================
# AI AGENT CONFIGURATION
# ============================================================================
# Server-only AI backend used by /api/ai/chat. Never use NEXT_PUBLIC_ here —
# that inlines the URL into the browser bundle and DevTools.
TOWER_AI_API=https://your-ai-backend.example
TOWER_AI_API_KEY=your-tower-ai-api-key
# Optional extra browser origins (comma-separated). tower.exchange is already allowed.
# Used by AI routes, in-app catalog/swap APIs, and RPC broadcasts.
# TOWER_AI_ALLOWED_ORIGINS=https://app.tower.exchange
# TOWER_ALLOWED_ORIGINS=https://preview.tower.exchange

# ============================================================================
# BACKEND API
# ============================================================================
# Backend service URL for API calls
NEXT_PUBLIC_BACKEND_URL=https://tower-backend.vercel.app

# Server-only backend URL used by Supabase Edge Functions for recurring swaps.
# Also used by server API routes that proxy protected Tower-Backend actions.
# Do not point this at the Tower-Exchange-AI chat service.
# TOWER_BACKEND_URL=https://tower-backend.vercel.app
# Server-only. Never expose this as NEXT_PUBLIC_*.
# Required when Tower-Backend protects fee distribution or swap transaction routes.
# TOWER_BACKEND_API_KEY=your-shared-backend-secret
# TOWER_BACKEND_AUTH_HEADER=Authorization
# If Tower-Backend expects a custom shared-secret header, set for example:
# TOWER_BACKEND_AUTH_HEADER=x-internal-secret
# TOWER_BACKEND_MAX_ATTEMPTS=3
# TOWER_BACKEND_MAX_RETRY_DELAY_MS=15000

# One-off FeeCollector maintenance scripts
# FEE_COLLECTOR_SPLIT_ADDRESS=0xB75B3b4f75327276Fa8aD9975cdD2d3B4abf1945
# FEE_DRAIN_RECIPIENT=0xYourTreasuryWallet
# FEE_COLLECTOR_COLLECTOR_PRIVATE_KEY=your-authorized-collector-private-key

# ============================================================================
# DZAP AGGREGATOR
# ============================================================================
# Server-only DZap Trade API key. Optional; raises rate limits.
# Get one from DZap (x-api-key). Never expose as NEXT_PUBLIC_*.
# DZAP_API_KEY=dzap_xxxxxxxxxxxxxxxxxxxxxxxx
# Set either flag to false to disable DZap-backed Tower quotes.
# DZAP_ENABLED=true
# NEXT_PUBLIC_DZAP_ENABLED=true
# DZap adapter for TowerSwapExecutor fee collection (same pattern as Aero).
# Deploy with contracts `npm run deploy:dzap-adapter:mainnet`, then set:
# NEXT_PUBLIC_DZAP_ADAPTER_MAINNET_ADDRESS=0xYourDzapAdapter
# NEXT_PUBLIC_DZAP_ADAPTER_ADDRESS=0xYourTestnetDzapAdapter

# ============================================================================
# XYLONET / LI.FI (Arc mainnet 5042)
# ============================================================================
# XyloNet does not run its own AMM on mainnet. Quotes and swaps go through
# LI.FI with integrator `xylonet` (0.10% integrator fee) to the LI.FI Diamond
# at 0xA4072583658Fae592A3506A42431cb6316a8d40b. See https://www.xylonet.xyz/docs/swap
# XyloNet quote row and LI.FI quotes. Off unless both are true.
XYLONET_ENABLED=false
NEXT_PUBLIC_XYLONET_ENABLED=false
# Set both to true to show XyloNet again.
# Optional LI.FI API key. Without it, public quote rate limits will blank XyloNet.
# LIFI_API_KEY=
# XYLONET_LIFI_API_KEY=
# Optional placeholder fromAddress for display quotes when no wallet is sent.
# XYLONET_QUOTE_ACCOUNT=0xb3966683724303400B6fECDa1963825d994B546a
# LI.FI adapter for TowerSwapExecutor 30 bps fee collection (DZap/Aero pattern).
# The testnet XyloNetAdapter.sol is a pool AMM wrapper and is not used on mainnet.
# Deploy with contracts `npm run deploy:lifi-adapter:mainnet`, then set:
# NEXT_PUBLIC_LIFI_ADAPTER_MAINNET_ADDRESS=0x02BC1b3F3A4655a5273b914c37ED4388DEaC58FE

# ============================================================================
# KYBERSWAP AGGREGATOR (Arc mainnet 5042)
# ============================================================================
# KyberSwap MetaAggregationRouterV2 is deployed at
# 0x6131B5fae19EA4f9D964eAc0408E4408b66337b5 on Arc. Quotes use
# GET /arc/api/v1/routes and swaps use POST /arc/api/v1/route/build.
# See https://docs.kyberswap.com/developer-guide/aggregator-api/contracts
# Do not allowlist the Kyber router on TowerSwapExecutor. Deploy
# KyberSwapAdapter and allowlist that adapter as both route target and
# approval spender (same pattern as DZap / LI.FI / Aero).
# KYBERSWAP_ENABLED=true
# NEXT_PUBLIC_KYBERSWAP_ENABLED=true
# Optional client id (sent as X-Client-Id). Defaults to tower-exchange.
# KYBERSWAP_CLIENT_ID=tower-exchange
# Optional API key for https://api.kyberswap.com/swap/ (X-Api-Key).
# KYBERSWAP_API_KEY=
# Optional aggregator base URL. Default is the public aggregator.
# KYBERSWAP_API_URL=https://aggregator-api.kyberswap.com
# Deploy with contracts `npm run deploy:kyberswap-adapter:mainnet`, then set:
# NEXT_PUBLIC_KYBERSWAP_ADAPTER_MAINNET_ADDRESS=0xYourKyberSwapAdapter

# ============================================================================
# UNISWAP V4 (Arc mainnet 5042)
# ============================================================================
# Uniswap v4 quotes use the on-chain V4Quoter (quoteExactInputSingle /
# quoteExactInput) as described at
# https://developers.uniswap.org/docs/sdks/v4/guides/swapping/quoting
# Swap calldata is encoded for Universal Router 2.1.2
# (0x8702463e73f74d0b6765aBceb314Ef07aCb92650) and executed through
# UniswapV4Adapter. Do not allowlist Universal Router or PoolManager on
# TowerSwapExecutor. Deploy the adapter and allowlist it as both route
# target and approval spender (same pattern as DZap / LI.FI / Kyber / Aero).
# UNISWAP_ENABLED=true
# NEXT_PUBLIC_UNISWAP_ENABLED=true
# Deploy with contracts `npm run deploy:uniswap-adapter:mainnet`, then set:
# NEXT_PUBLIC_UNISWAP_ADAPTER_MAINNET_ADDRESS=0xYourUniswapV4Adapter

# ============================================================================
# DE1 EXCHANGE AGGREGATOR (Arc mainnet 5042)
# ============================================================================
# De1 V4 quotes and swaps use https://open-api.de1.exchange/v4/arc
# (GET /quote and GET /swap). See https://docs.de1.exchange/docs/swap-api/v4
# Amounts use native token decimals (amountDecimals / gasPriceDecimals).
# Tower platform fees are collected by TowerSwapExecutor, not by De1. Do not
# allowlist De1's exchange (0x6352a56caadC4F1E25CD6c75970Fa768A3304e64) on
# the executor. Deploy De1Adapter and allowlist that adapter as both route
# target and approval spender (same pattern as DZap / LI.FI / Kyber / Aero).
# DE1_ENABLED=true
# NEXT_PUBLIC_DE1_ENABLED=true
# Deploy with contracts `npm run deploy:de1-adapter:mainnet`, then set:
# NEXT_PUBLIC_DE1_ADAPTER_MAINNET_ADDRESS=0xYourDe1Adapter
# Optional API key. Referrer is tracking-only when the executor collects fees;
# do not also set DE1_REFERRER_FEE on that path or users are charged twice.
# DE1_API_KEY=
# DE1_REFERRER=
# DE1_REFERRER_FEE=

# ============================================================================
# ATLAS AI AUTHENTICATION (one-time $0.10 USDC on Arc mainnet)
# ============================================================================
# On first Atlas interaction the frontend prompts a native USDC payment, then
# writes wallet_connections.authenticated = true after the tx confirms.
# Defaults to enabled. Set false only for local development without Arc USDC.
# NEXT_PUBLIC_ATLAS_AUTH_ENABLED=true
# NEXT_PUBLIC_ATLAS_AUTH_FEE_USDC=0.10
# NEXT_PUBLIC_ATLAS_AUTH_FEE_RECIPIENT=0xYourTreasuryWallet
# Server-only team allowlist. Comma, space, or newline separated addresses skip
# the $0.10 fee and are marked authenticated in wallet_connections.
# ATLAS_AUTH_WHITELIST=0xTeamWalletOne,0xTeamWalletTwo

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features in development
# NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# Emergency swap pause.
# Defaults to paused unless both server/client deployment envs explicitly set false.
# SWAPS_DISABLED=true
# NEXT_PUBLIC_SWAPS_DISABLED=true
